# Track B web app — environment (copy to .env.local; never commit .env*)
# API_MODE=mock  -> in-app MockApiClient (default, no server needed)
# API_MODE=real  -> RealApiClient against the Track A pipeline API (prompt B7)
API_MODE=mock
# Base URL of the Pipeline API, used only when API_MODE=real
API_BASE_URL=http://localhost:8000
