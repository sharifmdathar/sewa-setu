# OpenAI-compatible endpoint used by the extraction / adjudication LLM clients.
# Any endpoint that speaks the OpenAI chat-completions shape works. Verified free-of-cost
# options, and the base_url each needs (see docs/track-a/live-model-leg.md for the trade-offs):
#   NVIDIA NIM, no card       LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   Google Gemini             LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama on this machine    LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_API_KEY=ollama
#   OpenRouter ":free"        LLM_BASE_URL=https://openrouter.ai/api/v1  (50 requests/day: too
#                             few for a corpus pass; fine for a 20-document image leg)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Response cache: one file per request under the var dir, so a re-run of a long eval pass only
# pays for what it has not already asked for. LLM_CACHE=0 disables it, LLM_CACHE_DIR relocates it.
LLM_CACHE=1
LLM_CACHE_DIR=

# Backoff between attempts when the endpoint is rate-limiting or unreachable (seconds).
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_CAP_SECONDS=30

# How many documents of one application to read at once. Leave it at 1 against a free tier:
# measured on NVIDIA, 9 documents cost 53 s in series and 69 s in parallel, because the throttle
# is per account. Raise it for a local model (Ollama) or a key with headroom.
LLM_MAX_CONCURRENCY=1

# Optional service settings (unset values are the defaults; neither is a secret).
# PIPELINE_VAR_DIR relocates the JSON store (default: services/pipeline/var) and, with it,
# the default cache directory.
# PIPELINE_LOG_LEVEL is debug | info | warning.
# Run uvicorn with --no-access-log: the app logs each request itself, as JSON.
PIPELINE_VAR_DIR=
PIPELINE_LOG_LEVEL=info
