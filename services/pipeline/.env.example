# OpenAI-compatible endpoint used by the extraction / adjudication LLM clients.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional service settings (unset values are the defaults; neither is a secret).
# PIPELINE_VAR_DIR relocates the JSON store (default: services/pipeline/var).
# PIPELINE_LOG_LEVEL is debug | info | warning.
# Run uvicorn with --no-access-log: the app logs each request itself, as JSON.
PIPELINE_VAR_DIR=
PIPELINE_LOG_LEVEL=info
